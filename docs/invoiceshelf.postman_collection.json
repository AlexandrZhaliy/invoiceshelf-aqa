{
  "info": {
    "name": "InvoiceShelf API (endpoints used by the tests)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests the autotests make. Run 'Login' first: it stores the token. Money is in minor units (5000 = 50.00). Variables: see the collection's Variables tab."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090/api/v1"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com"
    },
    {
      "key": "admin_password",
      "value": "1qaz2WSX3edc!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "invoice_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "payment_method_id",
      "value": ""
    },
    {
      "key": "currency_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    },
    {
      "key": "role_name",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reference data",
      "item": [
        {
          "name": "Company settings: currency",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/company/settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "company",
                "settings"
              ],
              "query": [
                {
                  "key": "settings[]",
                  "value": "currency"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"currency_id\", pm.response.json().currency);"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment methods (Cash, Check, ...)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payment-methods",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payment-methods"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"payment_method_id\", pm.response.json().data.find(m => m.name === \"Cash\").id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "companies"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Customer {{$timestamp}}\",\n  \"email\": \"qa.customer.{{$timestamp}}@example.com\",\n  \"phone\": \"+380000164670\",\n  \"currency_id\": {{currency_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"customer_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "{{customer_id}}"
              ]
            }
          }
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Items (catalog)",
      "item": [
        {
          "name": "Create catalog item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Catalog Item {{$timestamp}}\",\n  \"price\": 5000,\n  \"description\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A product in the catalog, which the invoice form offers in its Items list. Price in minor units: 5000 = 50.00."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"item_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_number\": \"QA-INVOICE-{{$timestamp}}\",\n  \"invoice_date\": \"2026-10-12\",\n  \"due_date\": \"2026-10-15\",\n  \"customer_id\": {{customer_id}},\n  \"template_name\": \"invoice1\",\n  \"items\": [\n    {\n      \"name\": \"QA Item {{$timestamp}}\",\n      \"description\": \"\",\n      \"quantity\": 1,\n      \"price\": 5000,\n      \"discount\": 0,\n      \"discount_val\": 0,\n      \"discount_type\": \"fixed\",\n      \"tax\": 0\n    },\n    {\n      \"name\": \"QA Item {{$timestamp}}\",\n      \"description\": \"\",\n      \"quantity\": 2,\n      \"price\": 2500,\n      \"discount\": 0,\n      \"discount_val\": 0,\n      \"discount_type\": \"fixed\",\n      \"tax\": 0\n    }\n  ],\n  \"sub_total\": 10000,\n  \"total\": 10000,\n  \"discount\": 0,\n  \"discount_val\": 0,\n  \"discount_type\": \"fixed\",\n  \"tax\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"invoice_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices"
              ]
            }
          }
        },
        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
                "{{invoice_id}}"
              ]
            }
          }
        },
        {
          "name": "Mark as sent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
                "{{invoice_id}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_number\": \"QA-PAYMENT-15e90ea1\",\n  \"payment_date\": \"2026-10-12\",\n  \"customer_id\": {{customer_id}},\n  \"invoice_id\": {{invoice_id}},\n  \"payment_method_id\": {{payment_method_id}},\n  \"amount\": 3000,\n  \"notes\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"payment_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List payments by customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payments?customer_id={{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "customer_id",
                  "value": "{{customer_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Roles and users",
      "item": [
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/roles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "roles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"qa-items-only-{{$timestamp}}\",\n  \"abilities\": [\n    {\n      \"ability\": \"view-item\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"role_id\", pm.response.json().data.id);",
                  "pm.collectionVariables.set(\"role_name\", pm.response.json().data.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user with that role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Limited User {{$timestamp}}\",\n  \"email\": \"qa.limited.{{$timestamp}}@example.com\",\n  \"password\": \"Qa-{{$timestamp}}-1!\",\n  \"companies\": [\n    {\n      \"id\": 1,\n      \"role\": \"{{role_name}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"user_id\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup (run last, in this order)",
      "item": [
        {
          "name": "Delete payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payments/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments",
                "delete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{payment_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/invoices/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
                "delete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{invoice_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "delete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [{{user_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete role (only after the user is gone)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "roles",
                "{{role_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/customers/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                "delete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{customer_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete catalog item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/items/delete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "items",
                "delete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{item_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}